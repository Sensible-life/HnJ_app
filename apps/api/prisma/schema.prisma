generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  INSPECTOR
  HOTEL_MANAGER
  HQ_ADMIN
}

enum SessionType {
  ROOM_PRO
  BATH_PRO
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  SYNCED_PENDING
}

enum CheckinMethod {
  QR
  NFC
}

enum ItemState {
  UNSET
  NORMAL
  CAUTION
  URGENT
  NOT_APPLICABLE
}

// FR: 점검 시작 시 서비스 구분 선택 (앱개발 메뉴 리스트.pdf 원안, docs/FEATURE_SCOPE.md 우선순위 A)
enum ServiceType {
  INITIAL_RENEWAL // 최초 리뉴얼
  REGULAR         // 정기점검
  EMERGENCY       // 긴급출동
  REINSPECTION    // 재점검
}

enum MediaType {
  BEFORE
  AFTER
  GENERAL
}

// FR: docs/FEATURE_SCOPE.md 우선순위 C — 짧은 동영상 등록
enum MediaKind {
  IMAGE
  VIDEO
}

// FR: docs/FEATURE_SCOPE.md 우선순위 B — 문제 유형별 통계(곰팡이/누수/악취 등)는
// InspectionItem.issueType(자유 텍스트/코드)으로 근사한다.

enum TicketStatus {
  PENDING
  APPROVED
  REINSPECT_REQUESTED
  RESOLVED
}

enum NotificationChannel {
  ALIMTALK
  PUSH
}

enum NotificationStatus {
  SENT
  FAILED
  CLICKED
}

model User {
  id                String              @id @default(uuid())
  name              String
  email             String              @unique
  phone             String?
  passwordHash      String
  role              Role
  createdAt         DateTime            @default(now())
  hotels            UserHotelMapping[]
  inspections       InspectionSession[]
  schedules         Schedule[]
  approvedTickets   IssueTicket[]       @relation("ApprovedBy")
  notifications     Notification[]

  @@map("users")
}

model Hotel {
  id           String             @id @default(uuid())
  name         String
  address      String
  region       String?
  rooms        Room[]
  schedules    Schedule[]
  managers     UserHotelMapping[]
  serviceRates ServiceRate[]

  @@map("hotels")
}

model UserHotelMapping {
  id      String @id @default(uuid())
  userId  String
  hotelId String
  user    User   @relation(fields: [userId], references: [id])
  hotel   Hotel  @relation(fields: [hotelId], references: [id])

  @@unique([userId, hotelId])
  @@map("user_hotel_mappings")
}

model Room {
  id          String              @id @default(uuid())
  hotelId     String
  building    String?
  floor       String
  roomNumber  String
  qrTagId     String?             @unique
  nfcTagId    String?             @unique
  hotel       Hotel               @relation(fields: [hotelId], references: [id])
  sessions    InspectionSession[]

  @@map("rooms")
}

model InspectionSession {
  id                   String              @id @default(uuid())
  roomId               String
  inspectorId          String
  parentSessionId      String?
  type                 SessionType
  status               SessionStatus       @default(IN_PROGRESS)
  serviceType          ServiceType?        @default(REGULAR)
  checkinMethod        CheckinMethod
  gpsLat               Float?
  gpsLng               Float?
  clientUuid           String?             @unique
  startedAt            DateTime            @default(now())
  completedAt          DateTime?
  inspectorOpinion     String?             // 담당자 의견 (점검 완료 시 입력)
  // FR: docs/FEATURE_SCOPE.md 우선순위 B — 객실 유형/청소 담당팀·완료시간/분실물
  roomType             String?
  cleaningTeam         String?
  cleaningCompletedAt  DateTime?
  lostItemFound        Boolean             @default(false)
  lostItemLocation     String?
  room             Room                @relation(fields: [roomId], references: [id])
  inspector        User                @relation(fields: [inspectorId], references: [id])
  parentSession    InspectionSession?  @relation("SessionLink", fields: [parentSessionId], references: [id])
  childSessions    InspectionSession[] @relation("SessionLink")
  items            InspectionItem[]
  report           Report?

  @@map("inspection_sessions")
}

model InspectionItem {
  id                    String            @id @default(uuid())
  sessionId             String
  category              String
  itemName              String
  state                 ItemState         @default(UNSET)
  comment               String?
  sortOrder             Int               @default(0)
  problemDescription    String?           // 문제 내용
  actionDescription     String?           // 조치 내용
  requiresHotelApproval Boolean           @default(false) // 호텔 승인 필요 여부
  issueType             String?           // 곰팡이/누수/악취 등 문제 유형 (우선순위 B 통계용)
  session    InspectionSession @relation(fields: [sessionId], references: [id])
  media      Media[]
  tickets    IssueTicket[]

  @@map("inspection_items")
}

model Media {
  id             String         @id @default(uuid())
  itemId         String
  url            String
  mediaType      MediaType
  mediaKind      MediaKind      @default(IMAGE) // FR: 우선순위 C — 짧은 동영상 등록
  watermarkMeta  Json?
  markingData    Json?
  uploadedAt     DateTime       @default(now())
  item           InspectionItem @relation(fields: [itemId], references: [id])

  @@map("media")
}

model IssueTicket {
  id                String         @id @default(uuid())
  itemId            String
  status            TicketStatus   @default(PENDING)
  repairMaterial    String?
  repairCost        Int?
  revisitDate       DateTime?
  approvedById      String?
  approvedAt        DateTime?
  requiresApproval  Boolean        @default(true) // 호텔 승인 필요 여부(항목에서 전파)
  comment           String?        // 호텔 담당자 의견/답변 (1-Click 승인/재점검 시 입력)
  item           InspectionItem @relation(fields: [itemId], references: [id])
  approvedBy     User?          @relation("ApprovedBy", fields: [approvedById], references: [id])
  notifications  Notification[]

  @@map("issue_tickets")
}

model Report {
  id          String            @id @default(uuid())
  sessionId   String            @unique
  pdfUrl      String?
  webUrl      String?
  generatedAt DateTime          @default(now())
  session     InspectionSession @relation(fields: [sessionId], references: [id])

  @@map("reports")
}

model Notification {
  id            String              @id @default(uuid())
  ticketId      String?
  targetUserId  String
  channel       NotificationChannel
  status        NotificationStatus  @default(SENT)
  actionToken   String?             @unique
  sentAt        DateTime            @default(now())
  ticket        IssueTicket?        @relation(fields: [ticketId], references: [id])
  targetUser    User                @relation(fields: [targetUserId], references: [id])

  @@map("notifications")
}

model Schedule {
  id              String       @id @default(uuid())
  hotelId         String
  assignedUserId  String
  visitsPerMonth  Int          @default(2)
  nextVisitDate   DateTime?
  lastVisitDate   DateTime?
  // FR: docs/FEATURE_SCOPE.md 우선순위 B — 긴급출동/재점검 일정 타입, 호텔 담당자와 일정 공유
  scheduleType    ServiceType? @default(REGULAR)
  shareToken      String?      @unique
  hotel           Hotel        @relation(fields: [hotelId], references: [id])
  assignedUser    User         @relation(fields: [assignedUserId], references: [id])

  @@map("schedules")
}

// FR: docs/FEATURE_SCOPE.md 우선순위 B — 청소팀별 인스펙션 점수 집계를 위한 청소팀 마스터
model CleaningTeam {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("cleaning_teams")
}

// FR: docs/FEATURE_SCOPE.md 우선순위 C — 요금 관리 (호텔앤잡 관리자 권한)
model ServiceRate {
  id          String       @id @default(uuid())
  hotelId     String?
  serviceType ServiceType
  price       Int
  unit        String       @default("건")
  note        String?
  updatedAt   DateTime     @updatedAt
  hotel       Hotel?       @relation(fields: [hotelId], references: [id])

  @@map("service_rates")
}
